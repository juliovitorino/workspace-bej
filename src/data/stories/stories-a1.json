                    "intentions": [
                        {
                            "intentionId": "sou-estou-agora",
                            "ptIntent": "estou",
                            "enIntent": "am"
                        }
                    ]
                },
                {
                    "pt": "De manhã, tive um problema com o computador e pedi ajuda à Ana.",
