                        {
                            "intentionId": "momento-passado-com-marcador-de-tempo",
                            "ptIntent": "comprei peças ontem",
                            "enIntent": "bought parts yesterday"
                        }
                    ]
                },
                {
                    "pt": "Agora, nós precisamos fazer um plano para montar o robô.",
                    "en": "Now, we need to make a plan to build the robot.",
